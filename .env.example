# GitHub 配置
# 你的 GitHub 用户名
VITE_GITHUB_USERNAME=your-github-username

# 要展示的仓库列表（用逗号分隔，留空则自动获取前6个star最多的仓库）
# 支持两种格式：
# 1. repo-name（使用上面配置的用户名）
# 2. owner/repo-name（指定组织或其他用户的仓库）
# 示例: my-repo,my-org/org-repo,another-user/public-repo
VITE_FEATURED_REPOS=

# 社交媒体链接
VITE_GITHUB_URL=https://github.com/your-username
VITE_LINKEDIN_URL=https://linkedin.com/in/your-profile

# ICP 备案号（选填，仅中国大陆网站需要）
# 格式示例: 京ICP备12345678号-1
VITE_ICP_NUMBER=

# 公安联网备案号（选填，仅中国大陆网站需要）
# 格式示例: 浙公网安备33021212345678号
# 备案图标请放置于 public/备案图标.png
VITE_PSB_NUMBER=

# Formspree 表单 ID
# 访问 https://formspree.io/ 注册并创建表单，获取表单 ID
# 例如: xxxYYYzzz
VITE_FORMSPREE_ID=
